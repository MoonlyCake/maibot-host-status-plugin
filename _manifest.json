{
  "manifest_version": 2,
  "id": "com.moonlycake.host-status",
  "version": "1.0.3",
  "name": "宿主机状态图",
  "description": "使用命令采样并绘制宿主机 CPU、内存、交换空间、硬盘和运行时间，无模型调用。",
  "author": {
    "name": "MoonlyCake",
    "url": "https://github.com/MoonlyCake"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/MoonlyCake/maibot-host-status-plugin",
    "homepage": "https://github.com/MoonlyCake/maibot-host-status-plugin",
    "documentation": "https://github.com/MoonlyCake/maibot-host-status-plugin/blob/main/README.md",
    "issues": "https://github.com/MoonlyCake/maibot-host-status-plugin/issues"
  },
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.12.0",
    "max_version": "2.16.99"
  },
  "plugin_type": "extension",
  "dependencies": [
    {
      "type": "python_package",
      "name": "psutil",
      "version_spec": ">=6.0,<8.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0,<13.0"
    }
  ],
  "capabilities": [
    "send.image",
    "send.text"
  ],
  "display": {
    "icon": {
      "type": "lucide",
      "value": "activity"
    }
  },
  "i18n": {
    "default_locale": "zh-CN"
  }
}
